import type { Prng } from '@dicebear/core';
{{#if hasTransform}}
import type { ComponentGroupCollection, ComponentPickCollection, ColorPickCollection, ComponentPick } from '../types.js';
{{else}}
import type { ComponentGroupCollection, ComponentPick } from '../types.js';
{{/if}}
import * as components from '../components/index.js';

type Props = {
  prng: Prng,
  group: string,
  values?: string[],
  {{#if hasTransform}}
  width: number,
  height: number,
  rotation: number[],
  translateX: number[],
  translateY: number[],
  {{/if}}
}

{{#if hasTransform}}
export function pickComponent({ prng, group, width, height, values = [], rotation, translateX, translateY }: Props): ComponentPick {
{{else}}
export function pickComponent({ prng, group, values = []}: Props): ComponentPick {
{{/if}}
  const componentCollection: ComponentGroupCollection = components;

  const key = prng.pick(values);

  {{#if hasTransform}}
  const pickedRotation = prng.integer(Math.min(...rotation), Math.max(...rotation));
  const pickedTranslateX = prng.integer(Math.min(...translateX), Math.max(...translateX));
  const pickedTranslateY = prng.integer(Math.min(...translateY), Math.max(...translateY));

  {{/if}}
  if (key && componentCollection[group][key]) {
    return {
      name: key,
      {{#if hasTransform}}
      value(
        this: Exclude<ComponentPick, undefined>,
        components: ComponentPickCollection,
        colors: ColorPickCollection
      ) {
        let result = componentCollection[group][key](components, colors);

        if (this.rotation || this.translateX || this.translateY) {
          result = `<g transform="translate(${(this.translateX ?? 0)}, ${this.translateY ?? 0}) rotate(${this.rotation ?? 0} ${width / 2} ${height / 2})">${result}</g>`;
        }

        return result;
      },
      rotation: pickedRotation,
      translateX: pickedTranslateX,
      translateY: pickedTranslateY,
      {{else}}
      value: componentCollection[group][key],
      {{/if}}
    };
  } else {
    return undefined;
  }
}
