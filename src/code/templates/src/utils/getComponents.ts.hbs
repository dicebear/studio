import type { Prng } from '@dicebear/core';
import type { Options, ComponentPickCollection } from '../types.js';
import { pickComponent } from './pickComponent.js';

type Props = {
  prng: Prng,
  options: Options
}

export function getComponents({ prng, options }: Props): ComponentPickCollection {
  {{#each components}}
  const {{@key}}Component = pickComponent({
    prng,
    group: '{{@key}}',
    values: options.{{@key}},
    {{#if ../hasTransform}}
    width: {{width}},
    height: {{height}},
    {{#hasRange this.settings.rotation}}
    rotation: options.{{@key}}Rotation?.length ? options.{{@key}}Rotation : [0],
    {{else}}
    rotation: [0],
    {{/hasRange}}
    {{#hasRange this.settings.translateX}}
    translateX: options.{{@key}}TranslateX?.length ? options.{{@key}}TranslateX : [0],
    {{else}}
    translateX: [0],
    {{/hasRange}}
    {{#hasRange this.settings.translateY}}
    translateY: options.{{@key}}TranslateY?.length ? options.{{@key}}TranslateY : [0],
    {{else}}
    translateY: [0],
    {{/hasRange}}
    {{/if}}
  });
  {{/each}}

  return {
    {{#each components}}
    {{#isNull this.settings.probability.length}}
    '{{@key}}': {{@key}}Component,
    {{else}}
    '{{@key}}': prng.bool(options.{{@key}}Probability) ? {{@key}}Component : undefined,
    {{/isNull}}
    {{/each}}
  }
};
