{
  "name": "@dicebear/studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "run-p dev:ui dev:code",
    "dev:ui": "vite build --watch",
    "dev:code": "vite build --config vite.config.code.ts --watch",
    "build": "run-s type-check build-ui build-code",
    "build-ui": "vite build",
    "build-code": "vite build --config vite.config.code.ts",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@lucide/vue": "^1.11.0",
    "@primeuix/themes": "^2.0.3",
    "change-case": "^5.4.4",
    "file-saver": "^2.0.5",
    "handlebars": "^4.7.7",
    "jszip": "^3.10.0",
    "pinia": "^3.0.4",
    "primevue": "^4.5.4",
    "rgb-hex": "^4.0.0",
    "sort-object-keys": "^1.1.3",
    "svgo": "^3.2.0",
    "svgson": "^5.2.1",
    "utility-types": "^3.11.0",
    "vue": "^3.5.27"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.122.0",
    "@primevue/auto-import-resolver": "^4.5.4",
    "@types/file-saver": "^2.0.7",
    "@types/json-schema": "^7.0.11",
    "@types/node": "^25.1.0",
    "@types/sort-object-keys": "^1.1.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "npm-run-all2": "^8.0.4",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.2",
    "vite-plugin-singlefile": "^2.0.3",
    "vue-tsc": "^3.2.4"
