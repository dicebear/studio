{
  "name": "@dicebear/studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "run-p dev:ui dev:code",
    "dev:ui": "vite build --watch",
    "dev:code": "vite build --config vite.config.code.ts --watch",
    "build": "run-s type-check build-ui build-code",
    "build-ui": "vite build",
    "build-code": "vite build --config vite.config.code.ts",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@lucide/vue": "^1.40.0",
    "@primeuix/themes": "^2.0.3",
    "change-case": "^5.4.4",
    "file-saver": "^2.0.5",
    "handlebars": "^4.7.9",
    "jszip": "^3.10.1",
    "pinia": "^4.0.3",
    "primevue": "^4.5.5",
    "rgb-hex": "^4.1.0",
    "sort-object-keys": "^2.1.0",
    "svgo": "^4.1.0",
    "svgson": "^5.3.1",
    "utility-types": "^3.11.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.138.0",
    "@primevue/auto-import-resolver": "^4.5.5",
    "@types/file-saver": "^2.0.7",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.4.1",
    "@types/sort-object-keys": "^1.1.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "npm-run-all2": "^9.0.3",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
